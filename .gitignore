# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environment
venv/
env/
ENV/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.code-workspace

# Build artifacts and compiled files
# *.spec  # Remove this line since you want to keep Calculator.spec
*.pyd
*.dll
*.exe
*.manifest
*.so
*.dylib

# Local project-specific files that shouldn't be tracked
*.log
.env

# MacOs virtual environment files
venv/

# Project specific additions
# Keep the Lists directory as it's needed for the build
!Lists/*.txt   # Allow tracking of txt files in Lists directory

# Matplotlib temporary files
.matplotlib/